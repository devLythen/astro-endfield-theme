---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PostList from '../components/PostList';

const posts = await getCollection('posts');
const publishedPosts = posts
  .filter((p) => !p.data.draft)
  .sort((a, b) => (b.data.date?.valueOf() ?? 0) - (a.data.date?.valueOf() ?? 0));
---

<Layout>
  <div class="bilingual-title">
    <div class="vertical-decor">
      <span class="vertical-text">POSTS</span>
    </div>
    <div class="zh">文章</div>
    <div class="en">Articles &amp; Notes</div>
  </div>

  <div class="bar-accent"></div>

  <div class="post-list-section">
    <PostList posts={publishedPosts} client:load />
  </div>
</Layout>

<style is:global>
  .post-list-section { margin-top: 0.5rem; }

  /* Post Card — compact, title-first */
  .post-card {
    border-bottom: 1px solid var(--line-border);
  }
  .post-card:first-child { border-top: 1px solid var(--line-border); }

  .post-card-link {
    display: block;
    padding: 1rem 0.6rem;
    text-decoration: none;
    color: inherit;
    border-radius: 4px;
    transition: background var(--transition-fast);
  }
  .post-card-link:hover {
    background: var(--bg-card-hover);
  }

  /* Title row: index + title + EN decor */
  .post-card-head {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
  }
  .post-card-index {
    font-family: var(--font-bender);
    font-size: 0.7rem;
    color: var(--text-tertiary);
    min-width: 1.4rem;
    opacity: 0.5;
  }
  .post-card-link:hover .post-card-index {
    opacity: 1;
    color: var(--emphasis-bg);
  }
  .post-card-title {
    font-size: 1.1rem;
    font-weight: 700;
    color: var(--text-primary);
    line-height: 1.3;
    flex: 1;
  }
  .post-card-link:hover .post-card-title {
    color: var(--text-on-yellow);
  }
  .post-card-label {
    font-family: var(--font-display);
    font-size: 0.55rem;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    opacity: 0.4;
    white-space: nowrap;
  }

  /* Meta row: date + description */
  .post-card-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.3rem;
    padding-left: 2.15rem;
  }
  .post-card-date {
    font-size: 0.72rem;
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    white-space: nowrap;
  }
  .post-card-desc {
    font-size: 0.78rem;
    color: var(--text-secondary);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Tags row — inline boxes, auto-wrap */
  .post-card-tags {
    display: flex;
    gap: 0.3rem;
    list-style: none;
    padding: 0;
    margin-top: 0.35rem;
    padding-left: 2.15rem;
    flex-wrap: wrap;
  }
  .post-card-tag {
    font-size: 0.62rem;
    color: var(--text-tertiary);
    font-family: var(--font-mono);
    padding: 0.15rem 0.45rem;
    border: 1px solid var(--line-border);
    border-radius: 2px;
    transition: all var(--transition-fast);
  }
  .post-card-link:hover .post-card-tag {
    background: var(--emphasis-bg);
    color: var(--emphasis-text);
    border-color: var(--emphasis-bg);
  }

  .post-list-empty {
    color: var(--text-secondary);
    font-style: italic;
  }
</style>
